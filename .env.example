# Email backend (used by POST /api/send-reset-email for password & PIN recovery).
# Leave these unset to run in "code on screen" mode — the recovery code is
# displayed locally but no email is sent. Set them to actually deliver mail.

# SMTP host, e.g. smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net
EMAIL_HOST=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for implicit TLS)
EMAIL_PORT=587

# true => implicit TLS (port 465). false/unset => STARTTLS.
EMAIL_SECURE=false

# SMTP credentials
EMAIL_USER=your-account@example.com
EMAIL_PASSWORD=your-smtp-app-password


# Optional "From" address; falls back to EMAIL_USER
EMAIL_FROM=volunteertrack@googlegroups.com


# ----- Server-backed accounts & school dashboards -----
# Postgres connection string. When unset, the server runs in email-only mode
# (no accounts API). On Render/Neon this is provided by the managed database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "disable" to turn off TLS for the DB connection (local dev only).
# Managed Postgres requires TLS, so leave this unset in production.
# PGSSL=disable

# Secret used to sign JWT auth tokens. REQUIRED in production — generate a long
# random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# JWT_SECRET=change-me-to-a-long-random-string

# Optional admin account seeded on boot (created only if it does not exist).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password


# ----- Cloudflare Turnstile (bot protection on public forms) -----
# Adds a proof-of-humanity check to the public, unauthenticated write
# endpoints (contact form + account registration). Entirely opt-in: leave
# both unset and the widget renders nothing / the server middleware is a
# no-op, so local dev and the client-only demo are unaffected.
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# — the site key is public (ships in the client bundle), the secret key is
# server-only. Both keys must be set together to take effect.

# Server-only secret, used by server/turnstile.js to call Cloudflare siteverify.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Public site key, rendered by src/components/Turnstile.jsx. VITE_ var, so it
# ships in the client bundle — that's expected for Turnstile.
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Frontend API URL (for production deployment).
# Must include /api suffix — the server mounts all routes under /api/*.
# Leave unset in local dev to use the Vite proxy (default: /api → localhost:10000).
# VITE_API_URL=https://your-backend-url.onrender.com/api

# Deployed frontend origin, allowed to call this API via CORS (credentialed).
# Set this on the backend (Render) to your Netlify site URL, e.g. https://your-site.netlify.app
# FRONTEND_URL=https://your-site.netlify.app

# Secret configured on a GitHub repo webhook (Settings > Webhooks, content
# type application/json, "Issues" events) pointed at
# POST <backend-url>/api/status/github-webhook. When set, opening/closing/
# reopening an issue on that repo creates/resolves/reopens a matching
# incident on the public /status page — see handleGithubWebhook in
# server/routes/status.js. Leave unset to disable (requests are ignored).
# GITHUB_WEBHOOK_SECRET=generate-a-long-random-value

# Public origin this site is served from (no trailing slash). Used for
# canonical/OG/Twitter URLs and to generate public/robots.txt +
# public/sitemap.xml at build time. Leave unset locally — falls back to
# http://localhost:5173 automatically (see vite.config.js). Set the real
# value as a Netlify dashboard env var once the domain is finalized.
# VITE_SITE_URL=https://your-site.netlify.app

# ----- Parent weekly progress digest -----
# Shared secret for the digest cron endpoint
# (POST /api/parent/internal/run-weekly-digest), checked against the x-cron-key
# header sent by .github/workflows/parent-weekly-digest.yml. Leave unset to
# disable that endpoint (it returns 503). Set the same value as a GitHub repo
# secret named CRON_SECRET.
# CRON_SECRET=generate-a-long-random-value

# This backend's own public origin (no trailing slash). Used to build the
# unsubscribe link in digest emails, and set as the GitHub repo variable
# PUBLIC_BACKEND_URL so the workflow knows where to POST. Falls back to the
# production backend URL when unset.
# PUBLIC_BACKEND_URL=https://your-backend-url.onrender.com

# HERE Technologies API key for the "Where" location search in Log Hours
# (src/lib/geocode.js). Optional — without it, search falls back to
# Nominatim/OpenStreetMap (free, no key, but weaker business-name coverage
# since it depends on OSM having that business tagged). Get a free key at
# https://platform.here.com (no credit card required for the free tier).
# This is a VITE_ var, so it ships in the client bundle — restrict it to your
# site's domain(s) in the HERE console rather than treating it as a secret.
# VITE_HERE_API_KEY=your-here-api-key
