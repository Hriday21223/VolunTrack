# Email backend (used by POST /api/send-reset-email for password & PIN recovery).
# Leave these unset to run in "code on screen" mode — the recovery code is
# displayed locally but no email is sent. Set them to actually deliver mail.

# SMTP host, e.g. smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net
EMAIL_HOST=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for implicit TLS)
EMAIL_PORT=587

# true => implicit TLS (port 465). false/unset => STARTTLS.
EMAIL_SECURE=false

# SMTP credentials
EMAIL_USER=your-account@example.com
EMAIL_PASSWORD=your-smtp-app-password


# Optional "From" address; falls back to EMAIL_USER
EMAIL_FROM=volunteertrack@googlegroups.com


# SMS backend (used for SMS-based 2FA, an alternative to the authenticator
# app). Leave these unset to run in "code on screen" mode — the OTP is
# logged server-side and returned to the client as devCode (never in
# production) instead of actually being texted. Set them to deliver real SMS.
# Sign up free at https://www.twilio.com/try-twilio (free trial credit,
# no charge until you upgrade).

# Twilio Account SID, from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token, from the Twilio Console dashboard.
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# The Twilio phone number (or Messaging Service SID) messages are sent from.
TWILIO_FROM_NUMBER=+15555550100


# ----- Server-backed accounts & school dashboards -----
# Postgres connection string. When unset, the server runs in email-only mode
# (no accounts API). On Render/Neon this is provided by the managed database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "disable" to turn off TLS for the DB connection (local dev only).
# Managed Postgres requires TLS, so leave this unset in production.
# PGSSL=disable

# Secret used to sign JWT auth tokens. REQUIRED in production — generate a long
# random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# JWT_SECRET=change-me-to-a-long-random-string

# Optional admin account seeded on boot (created only if it does not exist).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password

# Frontend API URL (for production deployment).
# Must include /api suffix — the server mounts all routes under /api/*.
# Leave unset in local dev to use the Vite proxy (default: /api → localhost:10000).
# VITE_API_URL=https://your-backend-url.onrender.com/api

# Deployed frontend origin, allowed to call this API via CORS (credentialed).
# Set this on the backend (Render) to your Netlify site URL, e.g. https://your-site.netlify.app
# FRONTEND_URL=https://your-site.netlify.app

# Public origin this site is served from (no trailing slash). Used for
# canonical/OG/Twitter URLs and to generate public/robots.txt +
# public/sitemap.xml at build time. Leave unset locally — falls back to
# http://localhost:5173 automatically (see vite.config.js). Set the real
# value as a Netlify dashboard env var once the domain is finalized.
# VITE_SITE_URL=https://your-site.netlify.app
