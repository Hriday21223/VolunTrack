{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/school/public-tasks/:id/calendar.ics", "destination": "https://voluntrack-backend-frrh.onrender.com/api/school/public-tasks/:id/calendar.ics" },
    { "source": "/api/comeback/unsubscribe/:token", "destination": "https://voluntrack-backend-frrh.onrender.com/api/comeback/unsubscribe/:token" },
    { "source": "/api/parent/digest/unsubscribe/:token", "destination": "https://voluntrack-backend-frrh.onrender.com/api/parent/digest/unsubscribe/:token" },
    { "source": "/api/parent/task-ok/:path*", "destination": "https://voluntrack-backend-frrh.onrender.com/api/parent/task-ok/:path*" },
    { "source": "/api/school/follows/unsubscribe/:path*", "destination": "https://voluntrack-backend-frrh.onrender.com/api/school/follows/unsubscribe/:path*" },
    { "source": "/api/auth/parent-consent/:path*", "destination": "https://voluntrack-backend-frrh.onrender.com/api/auth/parent-consent/:path*" },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-src blob: https://challenges.cloudflare.com https://docs.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
